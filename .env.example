# =============================================================================
# ForgeAI Environment Variables
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/forgeai?schema=public

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI Provider
# Primary: openai | mock
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_MS=60000

# Optional production fallback. If configured, ForgeAI automatically retries
# the primary provider and falls back when it is rate-limited/unavailable.
AI_FALLBACK_PROVIDER=anthropic
AI_FALLBACK_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Rate limiting (optional overrides)
# RATE_LIMIT_GLOBAL_IP_PER_MINUTE=60

# Observability (optional)
# SENTRY_DSN=
