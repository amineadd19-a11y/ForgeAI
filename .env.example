# =============================================================================
# ForgeAI Environment Variables
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/forgeai?schema=public

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI Provider (primary)
# Supported: openai | anthropic | google | xai | mock
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_MS=60000

# Fallback provider (used when primary fails)
AI_FALLBACK_PROVIDER=xai
AI_FALLBACK_MODEL=grok-3-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GOOGLE_GEMINI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# xAI / Grok (https://console.x.ai)
XAI_API_KEY=
XAI_MODEL=grok-3-mini
# GROK_API_KEY=   # alias also accepted

# Movie Studio media provider
FAL_KEY=

# Standalone Video Worker
VIDEO_WORKER_URL=http://localhost:8080
VIDEO_WORKER_TOKEN=
# Worker persistent job state uses PostgreSQL. It may share ForgeAI DATABASE_URL.
# VIDEO_WORKER_DATABASE_URL=
# Worker persistent output storage: S3-compatible object storage.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Rate limiting
# RATE_LIMIT_GLOBAL_IP_PER_MINUTE=60

# Observability
# SENTRY_DSN=
