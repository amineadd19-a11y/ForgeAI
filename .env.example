# ForgeAI Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/forgeai?schema=public
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI Provider: openai | anthropic | google | xai | openrouter | mock
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_MS=60000

# OpenRouter / Ox Alpha preview
OPENROUTER_API_KEY=
OX_ALPHA_REASONING_EFFORT=high

AI_FALLBACK_PROVIDER=xai
AI_FALLBACK_MODEL=grok-3-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GOOGLE_GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-3-mini
FAL_KEY=
VIDEO_WORKER_URL=http://localhost:8080
VIDEO_WORKER_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
